{
  "name": "roundtable",
  "version": "2.1.3",
  "description": "Multi-model consensus tools for Pi, backed by the Roundtable MCP server.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": "https://github.com/TejGandham/roundtable",
  "keywords": [
    "pi-package",
    "mcp",
    "consensus",
    "multi-model",
    "code-review"
  ],
  "files": [
    "extensions/pi/",
    "scripts/install-roundtable-binary.mjs",
    "skills/roundtable/",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/install-roundtable-binary.mjs",
    "check:pi": "tsc --noEmit && node --import tsx --test tests/pi/*.test.ts",
    "smoke:pi-package": "node scripts/smoke-pi-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/pi/index.ts"
    ],
    "skills": [
      "./skills/roundtable"
    ]
  }
}
