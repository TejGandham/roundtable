{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "extensions/pi/**/*.ts",
    "tests/pi/**/*.ts"
  ]
}
